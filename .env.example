# Content-Modeling Agent — configuration template.
# Copy to `.env`, fill in, then:  set -a; . ./.env; set +a
# (Nothing here is read automatically — you source it into your shell.)

# ── Source storefront (SAP Commerce OCC) ─────────────────────────────
# The OCC v2 base of the storefront you're modeling. Used by extract,
# nav-resolve, and media download. Default is the SAP demo backend.
export OCC_BASE_URL="https://40.76.109.9:9002/occ/v2"

# ── Target Contentstack stack ────────────────────────────────────────
export CS_API_KEY="blt..."                 # stack API key
export CS_MANAGEMENT_TOKEN="cs..."          # management token (seed/publish/verify)
export CS_DELIVERY_TOKEN="cs..."            # delivery token (cda_read verify; optional)
export CS_ENVIRONMENT="development"         # publish target (auto-created if missing)

# Region — default is North America. Override BOTH for EU/Azure/GCP.
#   EU:       https://eu-api.contentstack.com  /  https://eu-cdn.contentstack.com
#   Azure-NA: https://azure-na-api.contentstack.com / https://azure-na-cdn.contentstack.com
export CS_REGION_BASE="https://api.contentstack.io"   # management API base
export CS_CDA_BASE="https://cdn.contentstack.io"      # delivery API base
export CS_MASTER_LOCALE="en-us"

# ── Connector starter pack ───────────────────────────────────────────
# The agent ships a self-contained copy at vendor/starter-pack/content_types
# (used automatically). Only set this to point at a live connector checkout
# instead — e.g. to pick up newer content types.
# export CONNECTOR_STARTER_PACK="../contentstack-spartacus-feature/import-export/starter-pack/content_types"
