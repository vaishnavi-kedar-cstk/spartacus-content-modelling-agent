        "instruction": "Optional: wrap the menu after N items."
      }
    },
    {
      "display_name": "All Nodes",
      "uid": "all_nodes",
      "data_type": "reference",
      "reference_to": [
        "nav_node_flat"
      ],
      "mandatory": false,
      "unique": false,
      "multiple": true,
      "non_localizable": false,
      "field_metadata": {
        "ref_multiple": true,
        "ref_multiple_content_types": true,
        "instruction": "The flat pool of every node in this menu (all levels). The connector builds the tree from each node's parent_id."
