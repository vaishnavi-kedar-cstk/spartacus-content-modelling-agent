        "_default": true,
        "instruction": "Internal name."
      }
    },
    {
      "display_name": "Wrap After",
      "uid": "wrap_after",
      "data_type": "number",
      "mandatory": false,
      "unique": false,
      "multiple": false,
      "non_localizable": false,
