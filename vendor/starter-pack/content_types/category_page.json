{
  "title": "Category Page",
  "uid": "category_page",
  "description": "CMS overrides for SAP ProductListPageTemplate (category/search). One shared entry serves every PLP (facets/products hydrate from OCC).",
  "schema": [
    {
      "display_name": "Title",
      "uid": "title",
      "data_type": "text",
      "mandatory": true,
      "unique": false,
      "multiple": false,
      "non_localizable": false,
      "field_metadata": {
        "_default": true,
        "instruction": "Page title."
      }
    },
    {
      "display_name": "URL",
      "uid": "url",
      "data_type": "text",
      "mandatory": false,
      "unique": false,
      "multiple": false,
      "non_localizable": false,
      "field_metadata": {
        "instruction": "Route this page resolves at. Use \"/\" for the homepage."
      }
    },
    {
      "display_name": "Page Type",
      "uid": "page_type",
      "data_type": "text",
      "mandatory": false,
      "unique": false,
      "multiple": false,
      "non_localizable": false,
      "field_metadata": {
        "instruction": "SAP page type discriminator (e.g. ContentPage / ProductPage / CategoryPage)."
      }
    },
    {
      "display_name": "Template",
      "uid": "template",
      "data_type": "text",
      "mandatory": false,
      "unique": false,
      "multiple": false,
      "non_localizable": false,
      "field_metadata": {
        "instruction": "SAP page template. Keep \"ProductListPageTemplate\"."
      }
    },
    {
      "display_name": "Left Refinements",
      "uid": "product_left_refinements",
      "data_type": "reference",
      "reference_to": [
        "simple_responsive_banner_component",
        "simple_banner_component",
        "product_carousel_component",
        "cms_paragraph_component",
        "cms_link_component",
        "cms_flex_component"
      ],
      "mandatory": false,
      "multiple": true,
      "unique": false,
      "non_localizable": false,
      "field_metadata": {
        "ref_multiple": true,
        "ref_multiple_content_types": true,
        "instruction": "Maps to SAP slot ProductLeftRefinements. Leave empty to keep SAP's."
      }
    },
    {
      "display_name": "Product Grid",
      "uid": "product_grid_slot",
      "data_type": "reference",
      "reference_to": [
        "simple_responsive_banner_component",
        "simple_banner_component",
        "product_carousel_component",
        "cms_paragraph_component",
        "cms_link_component",
        "cms_flex_component"
      ],
      "mandatory": false,
      "multiple": true,
      "unique": false,
      "non_localizable": false,
      "field_metadata": {
        "ref_multiple": true,
        "ref_multiple_content_types": true,
        "instruction": "Maps to SAP slot ProductGridSlot. Leave empty to keep SAP's."
      }
    },
    {
      "display_name": "Product List",
      "uid": "product_list_slot",
      "data_type": "reference",
      "reference_to": [
        "simple_responsive_banner_component",
        "simple_banner_component",
        "product_carousel_component",
        "cms_paragraph_component",
        "cms_link_component",
        "cms_flex_component"
      ],
      "mandatory": false,
      "multiple": true,
      "unique": false,
      "non_localizable": false,
      "field_metadata": {
        "ref_multiple": true,
        "ref_multiple_content_types": true,
        "instruction": "Maps to SAP slot ProductListSlot. Leave empty to keep SAP's."
